<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ámonos - Detalles del Destino</title>
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/detalles.css">
    <link rel="stylesheet" href="css/footer.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>

    <header class="encabezado">
        <nav>
            <a href="index.html" class="logo-container">
                <img src="imagenes/descarga.png" alt="Ámonos Logo" class="logo-img">
                <span class="logo-text">ÁMONOS</span>
            </a>

            <ul class="menu-links">
                <li><a href="index.html">Inicio</a></li>
                <li><a href="explorar.html">Explorar destinos</a></li>
                <li><a href="planificador.html">Planificador</a></li>
                <li><a href="sobre-nosotros.html">Sobre Nosotros</a></li>
                <li><a href="perfil.html">Perfil</a></li>
            </ul>
            <a href="perfil.html" class="avatar" title="Mi Perfil">D</a>
        </nav>
    </header>

    <main class="container">

        <section class="destination-header">
            <div class="title-area">
                <div class="title-badge">Destino Destacado 2026</div>
                <h1 id="destino-nombre">Cargando destino...</h1>
                <div class="stars">
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                    <span class="star-icon">★</span>
                </div>
            </div>
            <button class="btn-primary" onclick="irAlPlanificador()">
                <i class="fa-solid fa-calendar-check"></i> Planificar este viaje
            </button>
        </section>

        <section class="carousel-container">
            <button class="carousel-btn btn-left" onclick="moverCarrusel(-1)">
                <i class="fa-solid fa-chevron-left"></i>
            </button>
            <div class="carousel-track" id="track">
                <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1600&q=80');"></div>
                <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1540206395-63a255672b61?auto=format&fit=crop&w=1600&q=80');"></div>
                <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1518548419970-588d957ca58d?auto=format&fit=crop&w=1600&q=80');"></div>
                <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1464822755-46a73520d7d8?auto=format&fit=crop&w=1600&q=80');"></div>
                <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1600&q=80');"></div>
            </div>
            <div class="carousel-dots" id="carouselDots">
                <span class="dot active" onclick="irASlide(0)"></span>
                <span class="dot" onclick="irASlide(1)"></span>
                <span class="dot" onclick="irASlide(2)"></span>
                <span class="dot" onclick="irASlide(3)"></span>
                <span class="dot" onclick="irASlide(4)"></span>
            </div>
            <button class="carousel-btn btn-right" onclick="moverCarrusel(1)">
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </section>

        <div class="details-grid" id="seccion-info">
            <section class="info-card card-modern main-info">
                <div class="info-header-premium">
                    <div class="location-wrapper">
                        <i class="fa-solid fa-location-dot"></i>
                        <span class="location-tag" id="destino-ubicacion"> Santa Ana, El Salvador</span>
                    </div>
                    <h2 class="section-title-premium">La Experiencia</h2>
                </div>

                <p class="description-text" id="destino-descripcion">
                    Cargando descripción...
                </p>

                <div class="activities-wrapper">
                    <h2 class="section-title-premium">Lo que no te puedes perder</h2>
                    <ul class="activities-grid" id="activitiesList">
                        <!-- Actividades generadas dinámicamente -->
                    </ul>
                </div>

                <div class="community-gallery-premium">
                    <div class="gallery-header-premium">
                        <h2 class="section-title-premium">Momentos Reales 📸</h2>
                        <label for="userPhotoInput" class="upload-btn-premium">
                            <i class="fa-solid fa-cloud-arrow-up"></i> Subir mi foto
                        </label>
                        <input type="file" id="userPhotoInput" accept="image/*" multiple onchange="agregarFotosComunidad(event)" hidden>
                    </div>
                    <div class="user-gallery-grid" id="userGalleryGrid">
                        <img src="https://i.pinimg.com/736x/e4/2f/02/e42f029c72f9092539f18fa5720af0c9.jpg" class="user-gallery-item" alt="Lake view">
                        <img src="https://i0.wp.com/www.chiquithetraveller.com/wp-content/uploads/2018/05/lago-coatepeque-el-salvador-muelle.jpg?w=1280&ssl=1" class="user-gallery-item" alt="Coatepeque Pier">
                    </div>
                </div>
            </section>

            <section class="info-card card-modern" id="bloque-costos">
                <div class="cost-header-premium">
                    <h2 class="section-title-premium">Guía de Inversión</h2>
                    <button class="btn-plan-small" onclick="irAlPlanificador()">Optimizar Plan ➔</button>
                </div>

                <div class="investment-pillars" id="costTableBody">
                    <!-- Los pilares de inversión se generan dinámicamente aquí -->
                </div>

                <div class="budget-total-premium">
                    <span class="total-label">Inversión Total Estimada</span>
                    <span class="total-value" id="totalCost">$0.00</span>
                    <div class="verified-badge">
                        <i class="fa-solid fa-circle-check"></i> Presupuesto Verificado
                    </div>
                </div>

                <div class="reviews-premium-section">
                    <h2 class="section-title-premium">Opiniones</h2>
                    <div class="comments-container" id="commentsContainer">
                        <!-- Comentarios generados dinámicamente -->
                    </div>

                    <div class="add-review-premium">
                        <h3 class="review-title">Tu experiencia</h3>
                        <div class="star-rating-input">
                            <span class="star-select" data-value="1">★</span>
                            <span class="star-select" data-value="2">★</span>
                            <span class="star-select" data-value="3">★</span>
                            <span class="star-select" data-value="4">★</span>
                            <span class="star-select" data-value="5">★</span>
                        </div>
                        <textarea id="reviewText" placeholder="Comparte tu aventura..."></textarea>
                        <button type="submit" class="btn-review-submit">Publicar</button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <footer class="global-footer">
        <div class="footer-container">
            <div class="footer-top">
                <div class="footer-brand">
                    <a href="index.html" class="footer-logo">
                        <img src="imagenes/descarga.png" alt="Ámonos Logo">
                        <span>ÁMONOS</span>
                    </a>
                    <p>Hacemos que viajar por El Salvador sea accesible, mágico y diseñado exactamente para tu presupuesto.</p>
                    <div class="footer-socials">
                        <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                        <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </div>

                <div class="footer-links">
                    <div class="footer-col">
                        <h4>Explorar</h4>
                        <ul>
                            <li><a href="index.html">Inicio</a></li>
                            <li><a href="explorar.html">Destinos</a></li>
                            <li><a href="planificador.html">Planificador</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Soporte</h4>
                        <ul>
                            <li><a href="sobre-nosotros.html">Sobre Nosotros</a></li>
                            <li><a href="#">Términos y Condiciones</a></li>
                            <li><a href="#">Política de Privacidad</a></li>
                        </ul>
                    </div>
                </div>

                <div class="footer-newsletter">
                    <h4>Únete a la comunidad</h4>
                    <p>Recibe las mejores gemas ocultas y ofertas directamente en tu correo.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Tu correo electrónico">
                        <button type="submit">Suscribirse</button>
                    </form>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="footer-container">
                    <p>&copy; 2026 Ámonos. Todos los derechos reservados.</p>
                    <div class="footer-legal">
                        <a href="#">Privacidad</a>
                        <a href="#">Términos</a>
                        <a href="#">Contacto</a>
                        <a href="#">Ayuda</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="js/detalles.js"></script>
    <script src="js/auth-guard.js"></script>
</body>
</html>
